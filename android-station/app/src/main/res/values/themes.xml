<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ServaStation" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/chassis</item>
        <item name="android:windowBackground">@color/chassis</item>
        <item name="android:textColor">@color/ink</item>
        <item name="colorPrimary">@color/lime</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorControlActivated">@color/lime</item>
        <item name="android:statusBarColor">@color/chassis</item>
        <item name="android:navigationBarColor">@color/chassis</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Serva.Title" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="Serva.Body" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Serva.Input" parent="">
        <item name="android:background">@drawable/input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/faint</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/tap</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="Serva.Button.Primary" parent="">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/stamp_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/tap</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Serva.Button.Ghost" parent="Serva.Button.Primary">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
