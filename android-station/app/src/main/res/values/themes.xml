<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ServaStation" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:textColor">@color/ink</item>
        <item name="colorPrimary">@color/lime</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Serva.Title" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Serva.Body" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>
    <!-- The numbered eyebrow above each step, mirroring the dashboard's settings panes. -->
    <style name="Serva.Step" parent="">
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">@dimen/text_step</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Serva.Input" parent="">
        <item name="android:background">@drawable/input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/faint</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/tap</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="Serva.Button.Primary" parent="">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/fill_ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/tap</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Serva.Button.Ghost" parent="Serva.Button.Primary">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
