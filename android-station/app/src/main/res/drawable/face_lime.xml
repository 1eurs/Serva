<?xml version="1.0" encoding="utf-8"?>
<!-- Serva's "hard" shadow: 4dp, solid ink, zero blur. See the hard tokens in theme.css. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/drop" android:top="@dimen/drop">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
    <item android:right="@dimen/drop" android:bottom="@dimen/drop">
        <shape android:shape="rectangle">
            <solid android:color="@color/lime" />
            <stroke android:width="@dimen/border" android:color="@color/ink" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
</layer-list>
