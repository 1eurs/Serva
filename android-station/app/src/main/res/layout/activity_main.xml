<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chassis"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/gutter"
    android:paddingTop="28dp"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="28dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/slip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/slip"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="28dp"
            android:paddingEnd="26dp"
            android:paddingBottom="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/slip_max">

            <TextView
                android:id="@+id/wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.04"
                android:text="@string/wordmark"
                android:textColor="@color/ink"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/brandSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_subtitle"
                style="@style/Serva.Body" />

            <LinearLayout
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">
                <View android:id="@+id/tick1" android:layout_width="0dp" android:layout_height="3dp"
                    android:layout_weight="1" android:background="@drawable/tick_on" />
                <View android:id="@+id/tick2" android:layout_width="0dp" android:layout_height="3dp"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/tick_off" />
                <View android:id="@+id/tick3" android:layout_width="0dp" android:layout_height="3dp"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/tick_off" />
                <View android:id="@+id/tick4" android:layout_width="0dp" android:layout_height="3dp"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/tick_off" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/perforation" />

            <!-- ============ STATUS (once set up, this is the whole screen) ============ -->
            <LinearLayout android:id="@+id/statusBox" android:visibility="gone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/statusDot" android:layout_width="12dp" android:layout_height="12dp"
                        android:background="@drawable/dot_faint" />
                    <TextView android:id="@+id/statusHeadline" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.04"
                        android:textColor="@color/ink" android:textSize="@dimen/text_status" />
                </LinearLayout>
                <TextView android:id="@+id/statusDetail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Serva.Body" />

                <View android:layout_width="match_parent" android:layout_height="8dp"
                    android:layout_marginTop="20dp" android:background="@drawable/perforation" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="18dp">
                    <View android:id="@+id/cloudDot" android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/dot_faint" />
                    <TextView android:id="@+id/cloudHealth" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:textColor="@color/muted" android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <View android:id="@+id/printerHealthDot" android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/dot_faint" />
                    <TextView android:id="@+id/printerHealth" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:textColor="@color/muted" android:textSize="15sp" />
                </LinearLayout>
                <TextView android:id="@+id/stayAlive" style="@style/Serva.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/stay_alive" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/pause"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" style="@style/Serva.Button.Primary"
                    android:text="@string/pause_collecting" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/statusTest"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" style="@style/Serva.Button.Ghost"
                    android:text="@string/send_test" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/change"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" style="@style/Serva.Button.Ghost"
                    android:text="@string/change_setup" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/battery" android:visibility="gone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" style="@style/Serva.Button.Primary"
                    android:text="@string/allow_background" />
            </LinearLayout>

            <!-- ============ 1 · SIGN IN ============ -->
            <LinearLayout android:id="@+id/step1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingTop="10dp">
                <TextView style="@style/Serva.Title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/sign_in_title" />
                <TextView style="@style/Serva.Body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/sign_in_body" />
                <EditText android:id="@+id/username" style="@style/Serva.Input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/hint_username" android:inputType="textEmailAddress" />
                <EditText android:id="@+id/password" style="@style/Serva.Input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/hint_password" android:inputType="textPassword" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/signIn" style="@style/Serva.Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/sign_in" />
            </LinearLayout>

            <!-- ============ 2 · BRANCH ============ -->
            <LinearLayout android:id="@+id/step2" android:visibility="gone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingTop="10dp">
                <TextView style="@style/Serva.Title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/branch_title" />
                <TextView style="@style/Serva.Body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/branch_body" />
                <LinearLayout android:id="@+id/branchList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/back2" style="@style/Serva.Button.Ghost"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/back" />
            </LinearLayout>

            <!-- ============ 3 · PRINTER ============ -->
            <LinearLayout android:id="@+id/step3" android:visibility="gone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingTop="10dp">
                <TextView style="@style/Serva.Title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/printer_title" />
                <TextView android:id="@+id/printerBody" style="@style/Serva.Body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/printer_body" />
                <LinearLayout android:id="@+id/printerList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/scan" style="@style/Serva.Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/scan_again" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/cancelScan" style="@style/Serva.Button.Ghost"
                    android:visibility="gone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/cancel_scan" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/manual" style="@style/Serva.Button.Ghost"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/enter_manually" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/wider" style="@style/Serva.Button.Ghost"
                    android:visibility="gone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/search_wider" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/bluetooth" style="@style/Serva.Button.Ghost"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/use_bluetooth" />
                <LinearLayout android:id="@+id/manualBox" android:visibility="gone" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <EditText android:id="@+id/printerHost" style="@style/Serva.Input"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/hint_printer_ip" android:inputType="text" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/useManual" style="@style/Serva.Button.Ghost"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="@string/use_this_address" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/back3" style="@style/Serva.Button.Ghost"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/back" />
            </LinearLayout>

            <!-- ============ 4 · TEST ============ -->
            <LinearLayout android:id="@+id/step4" android:visibility="gone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingTop="10dp">
                <TextView style="@style/Serva.Title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/test_title" />
                <TextView android:id="@+id/testBody" style="@style/Serva.Body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/test_body" />
                <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/paper58" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/paper_58" android:textColor="@color/ink"
                    android:textSize="15sp" android:minHeight="@dimen/tap"
                    app:buttonTint="@color/lime" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/testPrint" style="@style/Serva.Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/send_test" />
                <LinearLayout android:id="@+id/askBox" android:visibility="gone" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/card" android:padding="16dp" android:layout_marginTop="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/did_it_print" android:textColor="@color/ink"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="18sp" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/yes" style="@style/Serva.Button.Primary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:text="@string/yes_printed" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/no" style="@style/Serva.Button.Ghost"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="@string/nothing_came_out" />
                </LinearLayout>
                <TextView android:id="@+id/troubleshoot" android:visibility="gone" style="@style/Serva.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/troubleshoot" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/back4" style="@style/Serva.Button.Ghost"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/back" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
