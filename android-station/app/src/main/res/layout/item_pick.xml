<?xml version="1.0" encoding="utf-8"?>
<!-- One tappable choice: a branch, or a printer the scan found. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/btn_ghost"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/tap"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView android:id="@+id/pickTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/pickSub"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="13sp" />
</LinearLayout>
