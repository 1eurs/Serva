{
  "name": "serva-print-station",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Headless Serva print station: pulls print jobs and writes them to a network thermal printer.",
  "scripts": {
    "start": "node station.mjs ./station.json",
    "fake:printer": "node fake-printer.mjs",
    "check:receipt": "node render-check.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "playwright-core": "^1.62.1",
    "playwright": "^1.62.1"
  },
  "engines": { "node": ">=20" }
}
