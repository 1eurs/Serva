# Where the Serva backend lives. Local dev default is http://localhost:8080.
SERVA_API_BASE=http://localhost:8080

# --- Auth: pick ONE ---------------------------------------------------------

# Preferred: a scoped, revocable API key minted from the dashboard's
#   POST /api/dashboard/api-keys   {"label":"...","scope":"READ_ONLY"}
# A READ_ONLY key can read everything the owner can and write nothing — the
# server refuses every non-GET request — so it's the safe default for an AI.
# No owner password ever touches this file, and you can revoke it without
# changing the owner's login.
SERVA_API_KEY=serva_sk_...

# Fallback: the café owner's dashboard login. Only used if SERVA_API_KEY is unset.
# SERVA_USERNAME=owner@example.com
# SERVA_PASSWORD=change-me

# ----------------------------------------------------------------------------

# Off by default. Set to 1 to let the AI run destructive/irreversible actions.
# Redundant with a READ_ONLY key (the server already blocks writes) — it only
# matters for a FULL key or password login.
SERVA_ALLOW_DESTRUCTIVE=0

# Optional: where the daily-report PDF is written. Defaults to the OS temp dir.
# SERVA_REPORT_DIR=/tmp
