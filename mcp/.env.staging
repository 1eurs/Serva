# Staging launch config for the Serva MCP.
# Credentials are the repo's public demo account (seeded by `npm run seed:staging`),
# not secrets — safe to commit. Do NOT put a real owner/prod login in a committed file.
SERVA_API_BASE=https://staging.serva.om

# Preferred once this backend (with API keys, V71) is deployed to staging: log in as
# the demo owner and mint a read-only key, then paste it here and drop the login below.
#   curl -sX POST https://staging.serva.om/api/dashboard/api-keys \
#     -H "Authorization: Bearer <owner-jwt>" -H 'content-type: application/json' \
#     -d '{"label":"MCP staging","scope":"READ_ONLY"}'
# SERVA_API_KEY=serva_sk_...

# Interim (works today): the repo's public demo login — not a secret, safe to commit.
SERVA_USERNAME=owner@mutrah.coffee
SERVA_PASSWORD=Owner123!

# Destructive actions stay off on shared staging by default (moot with a read-only key).
SERVA_ALLOW_DESTRUCTIVE=0
